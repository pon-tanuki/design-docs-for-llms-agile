{
  "$schema": "https://raw.githubusercontent.com/anthropics/claude-code/main/schema/settings.schema.json",
  "permissions": {
    "allow": [
      "Read(docs/**/*.md)",
      "Write(docs/**/*.md)",
      "Read(docs/**/*.yaml)",
      "Read(docs/**/*.yml)",
      "Read(.claude/**)",
      "Bash(mkdir:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git log:*)",
      "Bash(ls:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Write(src/**)",
      "Write(.github/**)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Write(./.git/**)",
      "Bash(rm -rf:*)",
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "outputStyle": "Explanatory",
  "includeCoAuthoredBy": true,
  "env": {
    "DOCS_DIR": "docs"
  }
}
